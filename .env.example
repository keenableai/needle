# Copy to .env and fill in — the keenbench CLI loads it automatically.
# Real exported environment variables take precedence over .env.

# Required for `keenbench freshstream generate` (LLM query projection),
# `freshstream run` (LLM judge), and `companyfill run --judge` — all via OpenRouter.
OPENROUTER_API_KEY=

# Optional: override the default OpenRouter model slug.
# KEENBENCH_LLM_MODEL=google/gemini-3.1-flash-lite

# Search clients (keenbench.shared.search).
# Keenable's public API works without a key (rate-limited); set one to raise limits.
# KEENABLE_API_KEY=
# Exa requires a key.
# EXA_API_KEY=

# Optional: override the default judge model slug (OpenRouter).
# KEENBENCH_JUDGE_MODEL=google/gemini-3-flash-preview
