# Copy to .env and fill in — the needle CLI loads it automatically.
# Real exported environment variables take precedence over .env.

# Required for `needle news generate` (LLM query projection), `news run`
# and `agentic_rare run` (LLM judge), and `finance run --judge` — all via OpenRouter.
OPENROUTER_API_KEY=

# Optional: override the default OpenRouter model slug.
# NEEDLE_LLM_MODEL=google/gemini-3.1-flash-lite

# Search clients (needle.shared.search).
# Keenable's public API works without a key (rate-limited); set one to raise limits.
# KEENABLE_API_KEY=
# Exa requires a key.
# EXA_API_KEY=
# Serper.dev powers the google engine.
# SERPER_API_KEY=
# SearchAPI (https://www.searchapi.io) powers the bing engine.
# SEARCHAPI_API_KEY=
# BRAVE_API_KEY=
# PARALLEL_API_KEY=
# TAVILY_API_KEY=
# PERPLEXITY_API_KEY=
# OCTEN_API_KEY=
# CERAMIC_API_KEY=
# YOU_API_KEY=

# Optional: override the default judge model slug (OpenRouter).
# NEEDLE_JUDGE_MODEL=google/gemini-3-flash-preview
