# Copy to .env and fill in — the needle CLI loads it automatically.
# Real exported environment variables take precedence over .env.
# Keys left empty are treated as unset.

# Required for `needle news generate` (LLM query projection), `news run`
# and `agentic_rare run` (LLM judge), and `finance run --judge` — all via OpenRouter.
OPENROUTER_API_KEY=

# Optional OpenRouter model overrides; both default to openai/gpt-5.6-terra.
NEEDLE_LLM_MODEL=
NEEDLE_JUDGE_MODEL=

# Search clients (needle.shared.search).
# Keenable's public API works without a key (rate-limited); set one to raise limits.
KEENABLE_API_KEY=
EXA_API_KEY=
# Serper.dev powers the google engine.
SERPER_API_KEY=
# SearchAPI (https://www.searchapi.io) powers the bing engine.
SEARCHAPI_API_KEY=
# Brave powers both brave (/web/search) and brave-llmcontext (/llm/context).
BRAVE_API_KEY=
PARALLEL_API_KEY=
TAVILY_API_KEY=
PERPLEXITY_API_KEY=
OCTEN_API_KEY=
CERAMIC_API_KEY=
YOU_API_KEY=
FIRECRAWL_API_KEY=
# Tavily search depth: basic or advanced.
TAVILY_DEPTH=basic

# CourtListener token for the legal bench sources.
COURTLISTENER_API_TOKEN=

# HF dataset for published run artifacts; HF_TOKEN is only needed to publish.
HF_DATASET=keenable-ai/needle-results
HF_TOKEN=
